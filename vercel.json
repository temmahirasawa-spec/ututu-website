{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "regions": [
    "hnd1"
  ],
  "headers": [
    {
      "source": "/(frames|frames_p|frames_lo|frames_lo_p|clips|models)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/v2",
      "destination": "https://ututu-website-git-claude-re-452d4f-temmahirasawa-1946s-projects.vercel.app/v2"
    },
    {
      "source": "/v2/:path*",
      "destination": "https://ututu-website-git-claude-re-452d4f-temmahirasawa-1946s-projects.vercel.app/v2/:path*"
    }
  ]
}
